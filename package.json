{
  "name": "hydractrl",
  "version": "1.2.0",
  "type": "module",
  "scripts": {
    "dev": "bun run build:client && bun --watch src/index.ts",
    "build": "bun run build:client",
    "build:production": "bun run build:client && bun run inject:analytics",
    "build:client": "bun run build:app && bun run build:site",
    "build:app": "bun build src/client/index.js src/client/output.js --outdir ./public/assets --minify --target browser --jsx-runtime automatic",
    "build:site": "bun build src/site/landing.js --outdir ./public/site --splitting --minify --target browser",
    "build:exe": "bun run build:client && bun build src/index.ts --compile --outfile hydractrl --target bun",
    "build:exe:full": "bun run build:exe && bun run copy:public",
    "copy:public": "bun scripts/copy-public.js",
    "inject:analytics": "bun run scripts/inject-analytics.js",
    "media": "bun run build && bun scripts/media/capture.js",
    "preview": "bun run build && bun src/index.ts",
    "lint": "biome check src/ scripts/ desktop/src/ desktop/scripts/",
    "format": "biome format --write src/ scripts/",
    "test": "bun test",
    "release:prepare": "bun scripts/release.js prepare",
    "release:check": "bun scripts/release.js check",
    "release:notes": "bun scripts/release.js notes"
  },
  "dependencies": {
    "@babel/runtime": "^7.24.1",
    "@codemirror/autocomplete": "^6.12.0",
    "@codemirror/commands": "^6.3.0",
    "@codemirror/lang-javascript": "^6.2.1",
    "@codemirror/language": "^6.11.0",
    "@codemirror/state": "^6.3.3",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@codemirror/view": "^6.22.3",
    "@lezer/highlight": "^1.2.1",
    "@uiw/codemirror-theme-monokai": "4.23.12",
    "@uiw/codemirror-theme-solarized": "4.23.12",
    "codemirror": "^6.0.1",
    "elysia": "^0.8.17",
    "hydra-synth": "^1.3.25"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.5.3",
    "@iconify-json/fe": "^1.2.2",
    "@types/p5": "^1.7.6",
    "@types/web": "^0.0.137",
    "bun-types": "latest",
    "p5": "^1.9.0",
    "playwright-core": "^1.56.1"
  }
}
